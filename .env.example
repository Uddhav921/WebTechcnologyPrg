# Copy this file to ".env" and fill in the two values marked REQUIRED.
# Setup steps: README.md ("Connect your Google Sheet")

# REQUIRED: the Web app URL you get after deploying apps-script/Code.gs
SHEETS_WEB_APP_URL=

# REQUIRED: the same SECRET text you set inside Code.gs
SHEETS_SECRET=

# Optional: your spreadsheet (only used for the "open sheet" link in the app)
GOOGLE_SHEET_ID=1-5Wac_ogpppboL1Dp1eJzoCndebULluAwDeD9x4l6Fs

# --- Google sign-in (login for the dashboard). Leave blank to run without a login. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails allowed to sign in (required when sign-in is on)
ALLOWED_EMAILS=
# Long random text; keeps you signed in across restarts (optional)
SESSION_SECRET=

# PORT=3000
